# ==============================================
# Gracelove Chapel Web Application - Environment Variables
# ==============================================

# Supabase Configuration (Get from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Admin & Notification Email
ADMIN_EMAIL=admin@gracelovechapel.com

# Resend API Key for Email Broadcasts and Contact Forms (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# Paystack Public Key for Online Giving / Donations (https://dashboard.paystack.com/#/settings/developer)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
